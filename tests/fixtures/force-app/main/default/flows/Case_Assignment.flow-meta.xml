<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <start>
        <connector>
            <targetReference>Check_Priority</targetReference>
        </connector>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <decisions>
        <name>Check_Priority</name>
        <label>Check Priority</label>
        <defaultConnector>
            <targetReference>Low_Priority_Assignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>Is_High_Priority</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>High_Priority_Assignment</targetReference>
            </connector>
            <label>High Priority</label>
        </rules>
    </decisions>
    <assignments>
        <name>High_Priority_Assignment</name>
        <label>High Priority Assignment</label>
        <assignmentItems>
            <assignToReference>$Record.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>EscalationQueue</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Low_Priority_Assignment</name>
        <label>Low Priority Assignment</label>
        <assignmentItems>
            <assignToReference>$Record.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>StandardQueue</elementReference>
            </value>
        </assignmentItems>
    </assignments>
</Flow>
